{
  "name": "fitflow-ai",
  "version": "1.0.0",
  "description": "FitFlow AI Core: workflows de desarrollo asistido reutilizables",
  "private": true,
  "files": [
    "src/contracts"
  ],
  "type": "commonjs",
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "sqlite3": "^6.0.1",
    "yaml": "^2.9.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/cli": "^0.1.18",
    "@types/node": "22.18.6",
    "typescript": "7.0.2",
    "vitest": "^4.1.11"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.typecheck.json --pretty false",
    "build": "tsc -p tsconfig.build.json --pretty false",
    "test:typed-core": "npm run build && node --test tests/contract/execution-coordination.test.js tests/core/execution-coordinator.test.js tests/operational-spine-v0/contracts-and-resolution.test.js tests/contracts/package-modes.test.js",
    "test:recipe-invocation": "npm run build && node --test tests/operational-spine-v0/recipe-invocation.test.js tests/operational-spine-v0/recipe-invocation-worker.test.js",
    "test": "npm run build && node --test tests/**/*.test.js scripts/doctor/tests/**/*.test.js",
    "contracts:check": "node src/contracts/validate-package.js",
    "contracts:publish": "npm publish ./src/contracts",
    "workspace:verify": "node scripts/workspace/verify.js",
    "recipe:invoke": "node src/operational-spine-v0/recipe-invocation-cli.js"
  },
  "allowScripts": {
    "better-sqlite3@13.0.3": true,
    "sqlite3@6.0.1": true
  }
}
