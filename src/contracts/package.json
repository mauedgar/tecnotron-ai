{
  "name": "@tecnotron-ai/contracts",
  "version": "1.0.0",
  "description": "Contratos canonicos de FitFlow-ai",
  "type": "commonjs",
  "main": "./index.js",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "require": "./index.js",
      "import": "./index.mjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "*.js",
    "*.mjs",
    "*.d.ts"
  ],
  "publishConfig": {
    "registry": "https://github.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mauedgar/tecnotron-ai.git",
    "directory": "src/contracts"
  },
  "dependencies": {
    "zod": "^4.4.3"
  },
  "scripts": {
    "build": "node ./validate-package.js",
    "pack:check": "node ./validate-package.js",
    "prepublishOnly": "npm run pack:check"
  }
}
