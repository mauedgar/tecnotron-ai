{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "ulc-implementer",
  "permissions": [
    {
      "action": "*",
      "resource": "*",
      "effect": "deny"
    }
  ],
  "agents": {
    "build": {
      "disabled": true
    },
    "plan": {
      "disabled": true
    },
    "general": {
      "disabled": true
    },
    "explore": {
      "disabled": true
    },
    "ulc-implementer": {
      "mode": "primary",
      "permissions": [
        {
          "action": "*",
          "resource": "*",
          "effect": "deny"
        }
      ]
    },
    "ulc-reviewer": {
      "mode": "primary",
      "disabled": true,
      "permissions": [
        {
          "action": "*",
          "resource": "*",
          "effect": "deny"
        },
        {
          "action": "read",
          "resource": "*",
          "effect": "allow"
        },
        {
          "action": "read",
          "resource": ".env",
          "effect": "deny"
        },
        {
          "action": "read",
          "resource": ".env.*",
          "effect": "deny"
        },
        {
          "action": "read",
          "resource": "**/.env",
          "effect": "deny"
        },
        {
          "action": "read",
          "resource": "**/.env.*",
          "effect": "deny"
        },
        {
          "action": "read",
          "resource": ".git/*",
          "effect": "deny"
        },
        {
          "action": "read",
          "resource": "**/.git/*",
          "effect": "deny"
        },
        {
          "action": "glob",
          "resource": "*",
          "effect": "allow"
        },
        {
          "action": "grep",
          "resource": "*",
          "effect": "allow"
        },
        {
          "action": "shell",
          "resource": "git diff *",
          "effect": "allow"
        },
        {
          "action": "shell",
          "resource": "git show *",
          "effect": "allow"
        },
        {
          "action": "shell",
          "resource": "git status *",
          "effect": "allow"
        }
      ]
    }
  }
}
