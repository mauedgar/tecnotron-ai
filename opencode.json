{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "ulc-implementer",
  "permissions": [
    {
      "action": "*",
      "resource": "*",
      "effect": "deny"
    }
  ],
  "agents": {
    "build": {
      "disabled": true
    },
    "plan": {
      "disabled": true
    },
    "general": {
      "disabled": true
    },
    "explore": {
      "disabled": true
    },
    "ulc-implementer": {
      "mode": "primary",
      "permissions": [
        {
          "action": "*",
          "resource": "*",
          "effect": "deny"
        }
      ]
    },
    "ulc-reviewer": {
      "mode": "primary",
      "disabled": true,
      "permissions": [
        {
          "action": "*",
          "resource": "*",
          "effect": "deny"
        }
      ]
    }
  }
}
